// leading single-line comment (trivia before root)

/* leading block comment
   also trivia before root */

{/* right after opening brace */"doubleQuoted"  :  "standard JSON string",
"withEscapes":
"tab:\there\nnewline\r\ncarriage return",
// comment between properties
      "unicodeEscape":/* between key and value */"Hello",
  "quotedKey" :    "JSON requires quoted keys", "_underscoreKey":
"keys can start with underscore",
               "$dollarKey": "keys can start with dollar sign","camelCaseKey":             "standard camelCase",
  "PascalCaseKey"/* comment before colon */ :
    "PascalCase also works",
"integer":123,
         "negative":      -456,"decimal":
123.456,"exponent":1.23e10,
    "exponentNegative" :
        1.23e-10,
"exponentPositive":               1.23E+10,
  "boolTrue":true,  "boolFalse": false,
"nullValue":
null,
"emptyArray":[],
  "singleElementArray": [/* single element */42],
      "simpleArray":[1,2,
// comment inside array
3],
"mixedArray":
[
1,"string",true,
null,
    {"nested":
"object"},
      [
"nested","array"]
],
  "emptyObject":{},
"singlePropertyObject":{"onlyKey":          "single"
},
                     "nestedObject":{
"level1":{    "level2":
    {"level3":
"deeply nested"}
  }},
"deepNesting":{"level1":{"value":"L1",
"level2":{   "value":         "L2","level3":
{"value":"L3",/* deep */
         "level4":{"value":"L4","level5":{"value":
"L5","arrayOfObjects":[{"item":1,
"nested":{"deep":true}
},{"item":2,"matrix":[[1,2,3],[4,5,
[6,7,[8]]]]}]}}}}}},
"arrayWithComments":
    [
// first
  "first",
      "second",// inline
/* block */ "third"  ],
              "lastProperty":"JSONC does not allow trailing comma"}
// trailing comment after closing brace
