SIMPLE_KEY=value
ANOTHER_KEY=123
EMPTY_VALUE=
PATH_LIKE=/usr/local/bin:/usr/bin:/bin
URL=https://example.com/path?query=value
SPECIAL_CHARS=foo:bar:baz
SINGLE_QUOTED='literal string with $VAR not expanded'
SINGLE_EMPTY=''
DOUBLE_QUOTED="string with expansion and escapes"
DOUBLE_EMPTY=""
DOUBLE_WITH_ESCAPES="line1\nline2\ttab\r\ncarriage"
DOUBLE_ESCAPED_QUOTE="string with \"escaped quotes\" inside"
MULTILINE="first line\
second line\
third line"
HOME_BIN=$HOME/bin
EDITOR=$VISUAL
PAGER=$LESS
APP_HOME=${HOME}/myapp
CONFIG_FILE=${XDG_CONFIG_HOME}/myapp.conf
CACHE_DIR=${XDG_CACHE_HOME}/myapp
LOG_DIR=${LOG_PATH:-/var/log/myapp}
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/1000}
DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
PORT=${PORT:-8080}
VERBOSE_FLAG=${DEBUG:+--verbose}
LOG_LEVEL=${VERBOSE:+debug}
LD_EXTRA=${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
CACHE_PATH=${CACHE_DIR:=/tmp/cache}
TMP_DIR=${TEMP:=/tmp}
API_KEY=${API_KEY:?API key must be set before running}
DB_PASS=${DB_PASSWORD:?DB_PASSWORD is required}
NESTED=${PRIMARY:-${FALLBACK:-ultimate_default}}
COMPLEX=${APP_HOST:-${HOSTNAME:-localhost}}
POLISH="Zażółć gęślą jaźń"
CYRILLIC="Привет мир"
CHINESE="你好世界"
EMOJI="🚀 Deploy 💻 Code 🔧 Fix"
MIXED="Hello Świat Мир 世界 🌍"
PATH=/opt/myapp/bin:$PATH
LD_LIBRARY_PATH=/opt/myapp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
XDG_DATA_DIRS=/opt/myapp/share:${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
